{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "registered_on",
    "mode",
    "question",
    "planned_question",
    "decision",
    "dataset_manifests",
    "contrasts",
    "features",
    "splits",
    "controls",
    "endpoints",
    "precision",
    "multiple_testing",
    "resources",
    "prior_art",
    "author_code",
    "qualification_fixture",
    "registration_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "registered_on": {
      "type": "string",
      "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "descriptive_qualification",
        "confirmatory"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "planned_question": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "domain_review",
        "reviewer",
        "wet_lab"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "data_limited",
            "qualified"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "domain_review": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "wet_lab": {
          "type": "string",
          "enum": [
            "not_scheduled",
            "registered_separately"
          ]
        }
      }
    },
    "dataset_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    },
    "contrasts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataset_ids",
          "sample_ids",
          "assays",
          "status",
          "estimand",
          "reason_codes",
          "genome_compatible",
          "age_compatible",
          "preparation_compatible",
          "perturbation_matched",
          "biological_units_known"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dataset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "sample_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "assays": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "descriptive_only",
              "excluded",
              "confirmatory_eligible"
            ]
          },
          "estimand": {
            "type": "string",
            "minLength": 1
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "genome_compatible": {
            "type": "boolean"
          },
          "age_compatible": {
            "type": "boolean"
          },
          "preparation_compatible": {
            "type": "boolean"
          },
          "perturbation_matched": {
            "type": "boolean"
          },
          "biological_units_known": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_sample_ids",
          "availability",
          "use",
          "eligible",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "unperturbed_reference",
              "post_perturbation",
              "metadata"
            ]
          },
          "source_sample_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "availability": {
            "type": "string",
            "enum": [
              "unperturbed",
              "post_perturbation",
              "unknown"
            ]
          },
          "use": {
            "type": "string",
            "enum": [
              "prediction",
              "explanation",
              "quality_control"
            ]
          },
          "eligible": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproduction_sample_ids",
        "discovery_sample_ids",
        "holdout",
        "leakage_policy",
        "genomic_block_policy"
      ],
      "properties": {
        "reproduction_sample_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "discovery_sample_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "identity_commitment",
            "public_sample_ids",
            "access_role",
            "public_training_exposure"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unselected",
                "reserved"
              ]
            },
            "identity_commitment": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "public_sample_ids": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "access_role": {
              "const": "evaluator_only"
            },
            "public_training_exposure": {
              "const": "unknown"
            }
          }
        },
        "leakage_policy": {
          "type": "string",
          "minLength": 1
        },
        "genomic_block_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "synthetic",
          "endpoint_id",
          "expected",
          "eligible_for_novelty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "positive_software",
              "negative_software",
              "biological_known",
              "unknown_candidate"
            ]
          },
          "synthetic": {
            "type": "boolean"
          },
          "endpoint_id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "eligible_for_novelty": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "metric",
          "unit",
          "success_rule",
          "practical_margin",
          "absolute_tolerance",
          "failure_rule",
          "data_limited_rule",
          "confirmatory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "software_reproduction",
              "biological_prediction"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked"
            ]
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "source_row",
              "independent_biological_sample"
            ]
          },
          "success_rule": {
            "type": "string",
            "minLength": 1
          },
          "practical_margin": {
            "type": "number"
          },
          "absolute_tolerance": {
            "type": "number",
            "minimum": 0
          },
          "failure_rule": {
            "type": "string",
            "minLength": 1
          },
          "data_limited_rule": {
            "type": "string",
            "minLength": 1
          },
          "confirmatory": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biological_replicates",
        "status",
        "analysis"
      ],
      "properties": {
        "biological_replicates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_estimable",
            "sufficient",
            "descriptive_only"
          ]
        },
        "analysis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "multiple_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_enabled",
        "method",
        "alpha",
        "family"
      ],
      "properties": {
        "inference_enabled": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": [
            "none",
            "benjamini_hochberg"
          ]
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_inference",
        "paid_compute",
        "funded_budget_usd",
        "assay_access"
      ],
      "properties": {
        "live_inference": {
          "const": false
        },
        "paid_compute": {
          "const": false
        },
        "funded_budget_usd": {
          "const": 0
        },
        "assay_access": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prior_art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "searched_on",
        "queries",
        "sources",
        "novelty_claim"
      ],
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "bounded_intake_only",
            "systematic_review_complete"
          ]
        },
        "searched_on": {
          "type": "string",
          "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}$"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "finding"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[^ ]+$"
              },
              "finding": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "novelty_claim": {
          "const": false
        }
      }
    },
    "author_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "revision",
        "license_status",
        "reused_code",
        "audit_artifact"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "license_status": {
          "const": "not_found_in_inspected_tree"
        },
        "reused_code": {
          "const": false
        },
        "audit_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "qualification_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "inputs"
      ],
      "properties": {
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "registration_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0thernet/algal-bio/schemas/bio-study.schema.json",
  "title": "Biology study registration v1",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dataset_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accession",
        "retrieved_on",
        "source",
        "projection",
        "sample_count",
        "samples",
        "annotation",
        "rights",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "accession": {
          "type": "string",
          "pattern": "^GSE[0-9]+$"
        },
        "retrieved_on": {
          "type": "string",
          "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "bytes",
            "local_filename",
            "retained_in_repository"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "local_filename": {
              "type": "string",
              "minLength": 1
            },
            "retained_in_repository": {
              "const": false
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "series",
              "title",
              "organism",
              "assay",
              "cell_preparation",
              "genotype_reported",
              "age_reported",
              "age_in_title",
              "replicate_label",
              "biosample_id",
              "biological_unit_id",
              "independence",
              "pooling",
              "genome_build",
              "issues"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^GSM[0-9]+$"
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "organism": {
                "type": "string",
                "minLength": 1
              },
              "assay": {
                "type": "string",
                "enum": [
                  "bulk_rna",
                  "scrna",
                  "atac",
                  "cutandrun",
                  "hic",
                  "chip"
                ]
              },
              "cell_preparation": {
                "type": "string",
                "minLength": 1
              },
              "genotype_reported": {
                "type": "string",
                "minLength": 1
              },
              "age_reported": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "age_in_title": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "replicate_label": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "biosample_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "biological_unit_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "independence": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "verified"
                ]
              },
              "pooling": {
                "type": "string",
                "enum": [
                  "unknown",
                  "pooled",
                  "individual"
                ]
              },
              "genome_build": {
                "type": "string",
                "minLength": 1
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            }
          },
          "minItems": 1
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported",
            "annotation_file_qualified",
            "source_line_numbers"
          ],
          "properties": {
            "reported": {
              "type": "string",
              "minLength": 1
            },
            "annotation_file_qualified": {
              "type": "boolean"
            },
            "source_line_numbers": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 0
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "policy_url",
            "notice"
          ],
          "properties": {
            "basis": {
              "const": "public_molecular_metadata"
            },
            "policy_url": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            },
            "notice": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "metadata_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_sha256",
        "selection",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "const": "sample_metadata_facts_v1"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_id",
              "lines",
              "source_notes"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "line_number",
                    "text"
                  ],
                  "properties": {
                    "line_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "source_notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "line_number",
                    "excerpt"
                  ],
                  "properties": {
                    "line_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 0
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
