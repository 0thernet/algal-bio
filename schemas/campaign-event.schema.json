{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0thernet/algal-bio/schemas/campaign-event.schema.json",
  "title": "Algal Bio append-only campaign event v1",
  "description": "The SHA-256 binds canonical JSON of every field except sha256. Journal order, role authority, state transitions, immutable registration and budget arithmetic require the executable verifier in addition to this envelope schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "previousSha256", "atMs", "kind", "data", "sha256"],
  "properties": {
    "schema": { "const": "algal-bio.campaign-event.v1" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "previousSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "atMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "kind": { "enum": ["campaign-created", "lease-acquired", "lease-released", "task-proposed", "proposal-invalid", "task-revised", "task-retried", "task-rejected", "task-admitted", "dispatch-intent", "job-observed", "spend-uncertain", "task-settled", "review-recorded", "access-granted", "access-denied", "admission-denied", "capability-denied"] },
    "data": { "type": "object", "maxProperties": 256 },
    "sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "task-proposed" } } },
      "then": { "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["proposal", "estimate"], "properties": { "proposal": { "$ref": "#/$defs/proposal" }, "estimate": { "$ref": "#/$defs/costs" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "task-settled" } } },
      "then": { "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["taskId", "status", "actualCost", "result", "breached"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "status": { "enum": ["completed", "failed", "cancelled"] }, "actualCost": { "$ref": "#/$defs/costs" }, "result": {}, "breached": { "type": "boolean" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "dispatch-intent" } } },
      "then": { "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["taskId", "submissionKey", "providerSha256"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "submissionKey": { "$ref": "#/$defs/sha256" }, "providerSha256": { "$ref": "#/$defs/sha256" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "review-recorded" } } },
      "then": { "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["taskId", "role", "kind", "reason", "evidence"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "role": { "enum": ["curator", "editor", "evaluator"] }, "kind": { "enum": ["curation", "editorial", "assessment"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }, "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "micros": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["inferenceMicros", "computeMicros", "storageMicros", "egressMicros", "recoveryMicros"],
      "properties": { "inferenceMicros": { "$ref": "#/$defs/micros" }, "computeMicros": { "$ref": "#/$defs/micros" }, "storageMicros": { "$ref": "#/$defs/micros" }, "egressMicros": { "$ref": "#/$defs/micros" }, "recoveryMicros": { "$ref": "#/$defs/micros" } }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "question", "instrumentId", "inputArtifactIds", "action", "parameters"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" }, "question": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "instrumentId": { "$ref": "#/$defs/id" },
        "inputArtifactIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "action": { "enum": ["json-observation", "execute-code"] }, "parameters": {}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "kind", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["primary-observation", "curation", "editorial", "assessment", "source"] },
        "locator": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
